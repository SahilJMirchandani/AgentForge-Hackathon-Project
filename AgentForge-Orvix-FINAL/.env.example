# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
APP_URL=http://localhost:5173

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000

# SMTP / Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESET_EMAIL_FROM=

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MongoDB (optional; local JSON storage is used when unset)
MONGODB_URI=
MONGODB_DB=agentforge
MONGODB_MAX_POOL_SIZE=10

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=
GOOGLE_REDIRECT_URI=
OAUTH_ENCRYPTION_KEY=
ALLOW_DEMO_OAUTH=false

# Security / proxy
TRUST_PROXY=false
ALLOWED_ORIGINS=http://localhost:5173
