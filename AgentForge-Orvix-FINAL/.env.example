# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
APP_URL=http://localhost:5173

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000

# Email (HTTPS delivery is preferred on Render Free)
# Brevo is preferred for normal recipients; the sender address must be verified.
BREVO_API_KEY=
BREVO_FROM=
BREVO_FROM_NAME=AgentForge

# Resend fallback (test sender may only deliver to the account owner's address)
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# SMTP fallback / local development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESET_EMAIL_FROM=

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MongoDB (optional; local JSON storage is used when unset)
MONGODB_URI=
MONGODB_DB=agentforge
MONGODB_MAX_POOL_SIZE=10

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=
ALLOW_DEMO_OAUTH=false

# Security / proxy
TRUST_PROXY=false
ALLOWED_ORIGINS=http://localhost:5173
